<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only to download the AVPBooter ROM piece from Apple (one HTTP Range request), as Henge on iOS does. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to tell Wi-Fi from mobile data before the IPSW download asks for confirmation (a normal permission, no prompt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="Henge JIT Probe"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- C0 + B0 screen and input test: no virtual machine, no network. Started from a button of MainActivity. -->
        <activity
            android:name=".DisplayTestActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize" />
        <!-- C1-3: information screen of the VM runner; starts nothing. Not exported, no Intent extras are read. -->
        <activity
            android:name=".VmRunnerActivity"
            android:exported="false" />
        <!-- [G4 UI] information screen of the G4 UI diagnostic runner; starts nothing, same shape as VmRunnerActivity
             above but for VmRunnerG4Launcher/libuirunnervmg4.so. Not exported, no Intent extras are read. -->
        <activity
            android:name=".VmRunnerG4Activity"
            android:exported="false" />
        <!-- [A] The real VM's screen. Process creation stays with VmRunnerLauncher (START_ENABLED=false in this
             build); this Activity only attaches to its shared file and renders. Not exported: nothing outside
             this app may launch it or hand it Intent extras (rom/disk/aux paths). -->
        <activity
            android:name=".VmDisplayActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize" />
        <!-- [A-G4] The G4-track counterpart of VmDisplayActivity above: same native SHM/JNI pipeline, same
             switch discipline, but through VmRunnerG4Launcher (START_ENABLED=false in this build) instead.
             Not exported; only this app may launch it or hand it Intent extras (rom/disk/aux/ipsw/ecid/workdir). -->
        <activity
            android:name=".VmDisplayG4Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize" />
        <!-- Shows and exports vm/snapshot.bmp (G0-G6's and the normal/installer boot test's one-shot screen
             capture). Not exported: nothing outside this app may launch it. -->
        <activity
            android:name=".SnapshotViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize" />
    </application>
</manifest>
